ninja_required_version = 1.3
cxx = c++
nvcc = /usr/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=pointops_cuda -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/linh/miniconda3/envs/cad_spotting_py310/lib/python3.10/site-packages/torch/include -isystem /home/linh/miniconda3/envs/cad_spotting_py310/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /home/linh/miniconda3/envs/cad_spotting_py310/include/python3.10 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=pointops_cuda -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/linh/miniconda3/envs/cad_spotting_py310/lib/python3.10/site-packages/torch/include -isystem /home/linh/miniconda3/envs/cad_spotting_py310/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /home/linh/miniconda3/envs/cad_spotting_py310/include/python3.10 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_120,code=compute_120 -gencode=arch=compute_120,code=sm_120 --compiler-options '-fPIC' -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/linh/miniconda3/envs/cad_spotting_py310/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build pointops_api.o: compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/pointops_api.cpp
build knnquery_cuda.o: compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/knnquery/knnquery_cuda.cpp
build knnquery_cuda_kernel.cuda.o: cuda_compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/knnquery/knnquery_cuda_kernel.cu
build interpolation_cuda.o: compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/interpolation/interpolation_cuda.cpp
build interpolation_cuda_kernel.cuda.o: cuda_compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/interpolation/interpolation_cuda_kernel.cu
build sampling_cuda.o: compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/sampling/sampling_cuda.cpp
build sampling_cuda_kernel.cuda.o: cuda_compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/sampling/sampling_cuda_kernel.cu
build subtraction_cuda.o: compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/subtraction/subtraction_cuda.cpp
build subtraction_cuda_kernel.cuda.o: cuda_compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/subtraction/subtraction_cuda_kernel.cu
build aggregation_cuda.o: compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/aggregation/aggregation_cuda.cpp
build aggregation_cuda_kernel.cuda.o: cuda_compile /home/16t/linh/linhreproduce_main/main/model/dxf_gnn/v1/svgnet/tools/pointops/src/aggregation/aggregation_cuda_kernel.cu





build pointops_cuda.so: link pointops_api.o knnquery_cuda.o knnquery_cuda_kernel.cuda.o interpolation_cuda.o interpolation_cuda_kernel.cuda.o sampling_cuda.o sampling_cuda_kernel.cuda.o subtraction_cuda.o subtraction_cuda_kernel.cuda.o aggregation_cuda.o aggregation_cuda_kernel.cuda.o

default pointops_cuda.so
